# 服务端口
PORT=3000

# JWT 密钥（自己改一个复杂的）
JWT_SECRET=your-super-secret-key-change-in-production

# PostgreSQL 连接串（从 Neon 复制）
# 格式: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/graduation-project?sslmode=require

# 允许的前端域名（逗号分隔，留空则允许所有）
FRONTEND_URL=https://your-app.vercel.app

# 运行环境
NODE_ENV=development